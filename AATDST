def is_balanced(s):
    stack = []
    i = {')': '(', '}': '{', ']': '['}

    for char in s:
        if char in i:
            top_element = stack.pop() if stack else '#'
            if i[char] != top_element:
                return "no"
        else:
            stack.append(char)
    return "yes" if not stack else "no"

print(is_balanced("{[()]}")) 
print(is_balanced("{())((}")))  
print(is_balanced("{){}"))

