def game(x, a, b):
    sum_a, sum_b = sum(a), sum(b)
    i, j = len(a), len(b)


    while i > 0 and sum_a > x:
        i -= 1
        sum_a -= a[i]
    while j > 0 and (sum_a + sum_b) > x:
        j -= 1
        sum_b -= b[j]
    count = i + j
    while i > 0 and j > 0:
        if a[i - 1] > b[j - 1]:
            i -= 1
            sum_a -= a[i]
        else:
            j -= 1
            sum_b -= b[j]
        count += 1

    return count
x = 10
a = [6, 7, 2, 3, 1]
b = [1, 2, 4, 9]
print(game(x, a, b)) 

